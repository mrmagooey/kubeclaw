# Source: kubeclaw/templates/credential-broker.yaml
# Credential broker RBAC: read Secrets and Pods, create TokenReviews.
#
# Trust widening: per-group credentials are dynamically named (kubeclaw-group-secrets-<group>),
# so the broker cannot enumerate them via resourceNames. The broker reads:
#   - kubeclaw-secrets (operator-provisioned built-in credentials)
#   - kubeclaw-group-secrets-<group> (user-supplied per-group credentials)
#   - kubeclaw-redis (shared Redis client password)
#   - per-channel HTTP secrets (for legacy built-in channels)
#   - admin-shell password (if admin shell is enabled)
#
# Accepted risk: the broker SA can technically read any Secret in the kubeclaw namespace.
# Mitigation: the broker code is hardened to read only what its in-memory catalog and
# per-group filtering permits. No code path reads Secrets outside this allowlist.
# Future hardening: sub-namespace for per-group Secrets.
#
# Pods read: needed for owner-group annotation lookup in both sidecar mode (TokenReview)
# and istio mode (IP-address → pod lookup for SPIFFE identity verification).
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: kubeclaw-credential-broker
  namespace: kubeclaw
rules:
  - apiGroups: [\"\"]
    resources: [\"secrets\"]
    verbs: [\"get\", \"list\", \"watch\"]
  - apiGroups: [\"\"]
    resources: [\"pods\"]
    verbs: [\"get\", \"list\", \"watch\"]
---
# Source: kubeclaw/templates/orchestrator.yaml
# Grants the orchestrator permission to create/list/delete tool Jobs and read pod logs.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: kubeclaw-job-manager
  namespace: kubeclaw
rules:
  - apiGroups: [\"batch\"]
    resources: [\"jobs\"]
    verbs: [\"create\", \"get\", \"list\", \"watch\", \"delete\"]
  - apiGroups: [\"\"]
    resources: [\"pods\"]
    verbs: [\"get\", \"list\", \"watch\"]
  - apiGroups: [\"\"]
    resources: [\"pods/log\"]
    verbs: [\"get\"]
  # Admin shell: create/patch per-channel secrets and trigger rolling restarts
  # Credential injection: create/update/delete per-group Secrets for user-supplied credentials
  - apiGroups: [\"\"]
    resources: [\"secrets\"]
    verbs: [\"create\", \"update\", \"patch\", \"delete\", \"get\", \"list\"]
  - apiGroups: [\"apps\"]
    resources: [\"deployments\"]
    verbs: [\"create\", \"get\", \"list\", \"watch\", \"update\", \"patch\", \"delete\"]
  # Per-group capability scale-down: PUT on deployments/scale (distinct from
  # `update` on deployments). Without this, the idle-sweeper's
  # replaceNamespacedDeploymentScale call 403s and the sweep silently no-ops.
  - apiGroups: [\"apps\"]
    resources: [\"deployments/scale\"]
    verbs: [\"get\", \"update\", \"patch\"]
  # MCP server lifecycle: create/update/delete services
  - apiGroups: [\"\"]
    resources: [\"services\"]
    verbs: [\"create\", \"get\", \"list\", \"watch\", \"update\", \"patch\", \"delete\"]
  # Admin shell: create per-channel PVCs; RAG capability removal deletes them
  - apiGroups: [\"\"]
    resources: [\"persistentvolumeclaims\"]
    verbs: [\"create\", \"get\", \"list\", \"watch\", \"update\", \"patch\", \"delete\"]
  # Admin shell: manage per-channel Ingress objects (namespace-scoped)
  - apiGroups: [\"networking.k8s.io\"]
    resources: [\"ingresses\"]
    verbs: [\"get\", \"list\", \"create\", \"patch\", \"replace\", \"delete\"]
  # ConfigMap access for: CatalogInformer (reads cred broker config),
  # SpecialistReconciler (writes kubeclaw-specialists).
  - apiGroups: [\"\"]
    resources: [\"configmaps\"]
    verbs: [\"get\", \"list\", \"create\", \"patch\", \"update\"]
---
