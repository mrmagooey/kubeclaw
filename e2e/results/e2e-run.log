    - api.openai.com
    - openrouter.ai
    - api.voyageai.com
  gateways:
    - mesh
    - kubeclaw-egressgateway
  http:
    - match:
        - gateways: [mesh]
          port: 80
          authority:
            exact: api.anthropic.com
      route:
        - destination:
            host: kubeclaw-istio-egressgateway.kubeclaw.svc.cluster.local
            port: { number: 80 }
    - match:
        - gateways: [kubeclaw-egressgateway]
          port: 80
          authority:
            exact: api.anthropic.com
      route:
        - destination:
            host: api.anthropic.com
            port: { number: 443 }
    - match:
        - gateways: [mesh]
          port: 80
          authority:
