"---
# Source: kubeclaw/templates/networkpolicies-istio.yaml
# Egress gateway is the ONLY pod allowed to reach the credential broker on the
# authz port in normal mode. When testFixture.enabled=true (e2e only), all
# in-namespace pods may also reach the broker directly so per-group credential
# tests can call /authz from the persistent probe pod via kubectl exec.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-broker-ingress-istio
  namespace: kubeclaw
spec:
  podSelector:
    matchLabels:
      app: kubeclaw-credential-broker
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              istio: kubeclaw-egressgateway
      ports:
        - protocol: TCP
          port: 8080
---
# Source: kubeclaw/templates/networkpolicies-istio.yaml
# Workload pods: restrict egress to DNS + in-namespace services.
# Istio iptables enforces the actual constraint; this adds a CNI-level layer.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-workload-egress-restricted-istio-tool-pod
  namespace: kubeclaw
spec:
  podSelector:
    matchLabels:
      app: kubeclaw-tool-pod
  policyTypes: [Egress]
  egress:
    - to: []
      ports: [{ protocol: UDP, port: 53 }]
    - to:
        - podSelector: { matchLabels: { app: kubeclaw-redis } }
      ports: [{ protocol: TCP, port: 6379 }]
    # Istio control plane traffic (xDS from istiod). Port 15012 is istiod's
    # gRPC port for certificate provisioning and config delivery.
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
      ports:
        - { protocol: TCP, port: 15012 }
    # Egress gateway: Envoy sidecar routes mesh traffic to the gateway pod on
    # port 8080 (the gateway's containerPort / targetPort). After DNAT by
    # kube-proxy the CNI evaluates NetworkPolicy against the pod port.
    - to:
        - podSelector:
            matchLabels:
              istio: kubeclaw-egressgateway
      ports:
        - { protocol: TCP, port: 8080 }
---
# Source: kubeclaw/templates/networkpolicies-istio.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-workload-egress-restricted-istio-sidecar-tool
  namespace: kubeclaw
spec:
  podSelector:
    matchLabels:
      app: kubeclaw-sidecar-tool
  policyTypes: [Egress]
  egress:
    - to: []
      ports: [{ protocol: UDP, port: 53 }]
    - to:
        - podSelector: { matchLabels: { app: kubeclaw-redis } }
      ports: [{ protocol: TCP, port: 6379 }]
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
      ports:
        - { protocol: TCP, port: 15012 }
    - to:
        - podSelector:
            matchLabels:
              istio: kubeclaw-egressgateway
      ports:
        - { protocol: TCP, port: 8080 }
---
# Source: kubeclaw/templates/networkpolicies-istio.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-workload-egress-restricted-istio-channel
  namespace: kubeclaw
spec:
  podSelector:
    matchExpressions:
      - { key: kubeclaw/channel, operator: Exists }
  policyTypes: [Egress]
  egress:
    - to: []
      ports: [{ protocol: UDP, port: 53 }]
    - to:
        - podSelector: { matchLabels: { app: kubeclaw-redis } }
      ports: [{ protocol: TCP, port: 6379 }]
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
      ports:
        - { protocol: TCP, port: 15012 }
    - to:
        - podSelector:
            matchLabels:
              istio: kubeclaw-egressgateway
      ports:
        - { protocol: TCP, port: 8080 }
