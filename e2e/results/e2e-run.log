# Source: kubeclaw/templates/credential-broker.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubeclaw-credential-broker
  namespace: kubeclaw
spec:
  replicas: 1
  selector: { matchLabels: { app: kubeclaw-credential-broker } }
  template:
    metadata:
      labels: { app: kubeclaw-credential-broker }
      annotations:
        checksum/config: 12a7a69264d013a23db24671d97a5e529cdd5af64b172246fddc7f3391f05643
    spec:
      serviceAccountName: kubeclaw-credential-broker
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: broker
          image: ghcr.io/mrmagooey/kubeclaw-credential-broker:latest
          imagePullPolicy: Never
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [\"ALL\"]
          env:
            - { name: KUBECLAW_MODE, value: credential-broker }
            - { name: BROKER_NAMESPACE, value: \"kubeclaw\" }
            - { name: BROKER_AUDIENCE, value: kubeclaw-credential-broker }
            - { name: BROKER_PORT, value: \"8080\" }
            - { name: BROKER_CONFIG_PATH, value: /etc/credential-broker/config.yaml }
            - name: BROKER_AUDIT_ONLY
              value: \"false\"
            - name: BROKER_METRICS_PORT
              value: \"9090\"
          ports:
            - { containerPort: 8080, name: http }
            - { containerPort: 9090, name: metrics }
          volumeMounts:
            - { name: config, mountPath: /etc/credential-broker }
          resources: 
            limits:
              cpu: 500m
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 2
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 3
      volumes:
        - name: config
          configMap: { name: kubeclaw-credential-broker-config }
