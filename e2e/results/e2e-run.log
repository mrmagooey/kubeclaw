# Source: kubeclaw/templates/orchestrator.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubeclaw-orchestrator
  namespace: kubeclaw
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kubeclaw-orchestrator
  template:
    metadata:
      labels:
        app: kubeclaw-orchestrator
        kubeclaw.io/role: orchestrator
      annotations:
        # The orchestrator is the trusted control-plane tier; it must not receive
        # an Istio sidecar even though the namespace label enables injection for
        # all other pods. The orchestrator accesses the K8s API directly using
        # its own SA credentials and does not need mesh identity.
        sidecar.istio.io/inject: \"false\"
    spec:
      serviceAccountName: kubeclaw-orchestrator
      securityContext:
        runAsUser: 0
        runAsNonRoot: false
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: fix-permissions
          image: busybox:latest
          command:
            - sh
            - -c
            - chown -R 1000:1000 /app/groups /app/store /data/sessions
          securityContext:
            runAsUser: 0
          volumeMounts:
            - name: groups
              mountPath: /app/groups
            - name: store
              mountPath: /app/store
            - name: sessions
              mountPath: /data/sessions
      containers:
        - name: orchestrator
          image: kubeclaw-orchestrator:latest
          imagePullPolicy: Never
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            capabilities:
              drop: [\"ALL\"]
            seccompProfile:
              type: RuntimeDefault
          env:
            - name: REDIS_URL
              value: redis://kubeclaw-redis:6379
            - name: REDIS_USERNAME
              value: orchestrator
            - name: REDIS_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: admin-password
            - name: REDIS_AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: agent-password
            - name: REDIS_TOOL_SERVER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: tool-server-password
            - name: REDIS_ADAPTER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: adapter-password
            - name: KUBECLAW_MODE
              value: orchestrator
            - name: KUBECLAW_RUNTIME
              value: kubernetes
            - name: KUBECLAW_NAMESPACE
              value: kubeclaw
            - name: KUBECLAW_IPC_BASE
              value: /data/sessions
            - name: MAX_CONCURRENT_JOBS
              value: \"10\"
            - name: ANTHROPIC_API_KEY
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: anthropic-api-key
                  optional: true
            - name: CLAUDE_CODE_OAUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: claude-code-oauth-token
                  optional: true
            # The orchestrator does NOT call LLM providers directly — per the
            # four-tier architecture, channels own LLM conversations. These
            # envs are reserved for future use and are intentionally not
            # rewritten by kubeclaw.istioBaseUrlEnv in mode=istio. If the
            # orchestrator ever starts making provider calls, gate these
            # behind mode=sidecar / mode=off and inject istioBaseUrlEnv here.
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: openai-api-key
                  optional: true
            - name: OPENAI_BASE_URL
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: openai-base-url
                  optional: true
            - name: DIRECT_LLM_MODEL
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: direct-llm-model
                  optional: true
            - name: ADMIN_HTTP_PORT
              value: \"9090\"
            - name: ADMIN_HTTP_USERNAME
              value: \"admin\"
            - name: ADMIN_HTTP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-secrets
                  key: admin-http-password
          ports:
            - name: health
              containerPort: 8080
              protocol: TCP
            - name: admin
              containerPort: 9090
              protocol: TCP
            - name: metrics
              containerPort: 9091
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /liveness
              port: health
            initialDelaySeconds: 15
            periodSeconds: 30
            failureThreshold: 3
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 5
          volumeMounts:
            - name: groups
              mountPath: /app/groups
            - name: store
              mountPath: /app/store
            - name: sessions
              mountPath: /data/sessions
            - name: specialists-baseline
              mountPath: /etc/kubeclaw/specialists-baseline
              readOnly: true
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: groups
          persistentVolumeClaim:
            claimName: kubeclaw-groups
        - name: store
          persistentVolumeClaim:
            claimName: kubeclaw-store
        - name: sessions
          persistentVolumeClaim:
            claimName: kubeclaw-sessions
        - name: specialists-baseline
          configMap:
            name: kubeclaw-specialists-baseline
            optional: true
