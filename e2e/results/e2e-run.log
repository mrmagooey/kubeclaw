# Source: kubeclaw/templates/redis.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kubeclaw-redis
  namespace: kubeclaw
spec:
  serviceName: kubeclaw-redis
  replicas: 1
  selector:
    matchLabels:
      app: kubeclaw-redis
  template:
    metadata:
      labels:
        app: kubeclaw-redis
        kubeclaw.io/role: redis
    spec:
      securityContext:
        fsGroup: 999
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: init-acl
          image: busybox:latest
          command:
            - sh
            - -c
            - |
              {
                echo \"user default off nopass ~* &* -@all\"
                echo \"user orchestrator on >$REDIS_ADMIN_PASSWORD ~* &* +@all\"
                echo \"user channel on >$REDIS_CHANNEL_PASSWORD ~kubeclaw:* resetchannels &kubeclaw:* +subscribe +unsubscribe +psubscribe +punsubscribe +publish +xadd +xread +xrange +ping +reset +quit +info\"
                echo \"user agent on >$REDIS_AGENT_PASSWORD ~kubeclaw:input:* ~kubeclaw:toolresults:* ~kubeclaw:toolcalls:* ~kubeclaw:spawn-tool-pod resetchannels &kubeclaw:messages:* &kubeclaw:tasks:* +xread +xadd +xrange +publish +ping +reset +quit\"
                echo \"user tool-server on >$REDIS_TOOL_SERVER_PASSWORD ~kubeclaw:toolcalls:* ~kubeclaw:toolresults:* resetchannels &kubeclaw:tasks:* &kubeclaw:messages:* +xread +xadd +xrange +publish +ping +reset +quit\"
                echo \"user adapter on >$REDIS_ADAPTER_PASSWORD %R~kubeclaw:input:* resetchannels &kubeclaw:messages:* +xread +xrange +publish +ping +reset +quit\"
              } > /data/redis-acl.conf
              chown -R 999:999 /data
          securityContext:
            runAsUser: 0
          env:
            - name: REDIS_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: admin-password
            - name: REDIS_CHANNEL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: channel-password
            - name: REDIS_AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: agent-password
            - name: REDIS_TOOL_SERVER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: tool-server-password
            - name: REDIS_ADAPTER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: kubeclaw-redis
                  key: adapter-password
          volumeMounts:
            - name: data
              mountPath: /data
      containers:
        - name: redis
          image: redis:7-alpine
          command:
            - redis-server
            - --appendonly
            - \"yes\"
            - --appendfsync
            - everysec
            - --maxmemory
            - 2gb
            - --maxmemory-policy
            - allkeys-lru
            - --aclfile
            - /data/redis-acl.conf
          env: []
          ports:
            - containerPort: 6379
          volumeMounts:
            - name: data
              mountPath: /data
          resources:
            limits:
              cpu: \"1\"
              memory: 2Gi
            requests:
              cpu: 100m
              memory: 256Mi
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce
        
        resources:
          requests:
            storage: 10Gi
---
# Source: kubeclaw/templates/istio-egress.yaml
# Egress Gateway Deployment — owned by the KubeClaw Helm chart (not by the
# Istio platform team). Labeled istio: kubeclaw-egressgateway so EnvoyFilter
# selectors and NetworkPolicy selectors can target it independently of the
# platform-level istio-egressgateway (if any).
---
# Source: kubeclaw/templates/networkpolicies-istio.yaml
# NetworkPolicies for mode=istio.
#
# Security model in istio mode vs. sidecar mode:
#   Sidecar mode: workload + sidecar share a netns, so NetworkPolicy cannot
#     distinguish their egress. Workloads can potentially bypass the proxy by
#     opening raw sockets. The hardening is operational (HTTP client config),
#     not policy-enforced.
#
#   Istio mode: the Istio sidecar uses iptables rules installed in the
#     workload's netns by the istio-init initContainer. ALL egress is
#     redirected to the Envoy proxy at port 15001 before it leaves the
#     netns. A workload cannot open a raw socket to the internet without
#     going through the proxy, which routes to the egress gateway, which
#     calls the credential broker. This is a genuine security upgrade.
#
# NetworkPolicy role in istio mode:
#   - We still use NetworkPolicy to restrict broker access. Only the egress
#     gateway pod should reach the broker on port 8080.
#   - Workload pods do not need a NetworkPolicy rule to reach the broker
#     directly — iptables inside their netns prevents direct access anyway,
#     and traffic goes through the gateway.
#   - Deny-all egress from workload pods (except DNS and in-namespace).
#     Istio's iptables already enforces this, but NetworkPolicy adds a
#     second defence-in-depth layer at the CNI level.
---
# Source: kubeclaw/templates/internal-ca.yaml
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: kubeclaw-egress-ca
  namespace: kubeclaw
  annotations:
    helm.sh/resource-policy: keep
spec:
  isCA: true
  commonName: kubeclaw-egress-ca
  secretName: kubeclaw-egress-ca-tls
  duration: 87600h
  renewBefore: 720h
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: kubeclaw-egress-ca-bootstrap
    kind: Issuer
