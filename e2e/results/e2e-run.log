# Source: kubeclaw/templates/networkpolicies.yaml
# Agents may only reach: DNS (UDP 53), Redis (TCP 6379), and HTTPS (TCP 443).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-agent-policy
  namespace: kubeclaw
spec:
  podSelector:
    matchLabels:
      app: kubeclaw-agent
  policyTypes:
    - Egress
  egress:
    - to: []
      ports:
        - protocol: UDP
          port: 53
    - to:
        - podSelector:
            matchLabels:
              app: kubeclaw-redis
      ports:
        - protocol: TCP
          port: 6379
---
# Source: kubeclaw/templates/networkpolicies.yaml
# Orchestrator: unrestricted egress (needs to create Jobs, call APIs, reach Redis).
# Ingress restricted to port 8080 (health/metrics).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-orchestrator-policy
  namespace: kubeclaw
spec:
  podSelector:
    matchLabels:
      app: kubeclaw-orchestrator
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from: []
      ports:
        - protocol: TCP
          port: 8080
  egress:
    - to: []
