    --set secrets.anthropicApiKey=YOUR_KEY \
    --set secrets.claudeCodeOauthToken=YOUR_TOKEN \
    -n kubeclaw-e2e-injection

NOTE: storage.accessMode is ReadWriteOnce. Concurrent tool jobs may fail
on multi-node clusters. For production use ReadWriteMany with a compatible
CSI driver (EFS, Azure Files, NFS, Ceph).
