  name: kubeclaw-egress-tls-api-anthropic-com
  namespace: kubeclaw
spec:
  host: api.anthropic.com
  trafficPolicy:
    portLevelSettings:
      - port:
          number: 443
        tls:
          mode: SIMPLE
          sni: api.anthropic.com
          caCertificates: /etc/ssl/certs/ca-certificates.crt
